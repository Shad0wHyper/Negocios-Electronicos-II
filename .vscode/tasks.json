{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Abrir navegador",
            "type": "shell",
            "osx": {
                "options": {
                    "shell": {
                        "executable": "/bin/sh",
                        "args": [
                            "-c"
                        ]
                    }
                },
                "command": "/usr/bin/python3 -c \"import subprocess; subprocess.Popen(['/bin/sh', '-c', 'sleep 2 && /usr/bin/open -a Safari http://localhost:8000'], start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\""
            },
            "windows": {
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/c"
                        ]
                    }
                },
                "command": "powershell -NoProfile -Command \"Start-Process powershell -WindowStyle Hidden -ArgumentList '-NoProfile','-Command','Start-Sleep -Seconds 2; Start-Process http://localhost:8000'\""
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        }
    ]
}
