{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.php",
      "Dockerfile",
      "composer.*",
      "credentials.json",
      "firebase_credentials.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "xanarchy-php",
          "region": "us-central1"
        }
      }
    ]
  }
}
